generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  images      String[]
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  subcategory String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  
  @@index([categoryId])
  @@index([slug])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  nombreCompleto String
  nombreCentro  String?
  email         String
  telefono      String
  direccion     String      @db.Text
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  couponCode    String?
  discountAmount Decimal?   @db.Decimal(10, 2)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([orderNumber])
  @@index([email])
  @@index([status])
  @@index([couponCode])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String   // Guardar nombre del producto al momento del pedido
  productSlug String   // Guardar slug del producto al momento del pedido
  quantity    Int
  price       Decimal  @db.Decimal(10, 2) // Precio al momento del pedido
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  
  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPercent Decimal  @db.Decimal(5, 2) // Porcentaje de descuento (ej: 10.00 = 10%)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([code])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}