generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  name            String
  slug            String           @unique
  description     String?
  price           Decimal?         @db.Decimal(10, 2)
  images          String[]
  stock           Int              @default(0)
  categoryId      String
  published       Boolean          @default(false)
  featured        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subcategory     String?
  proveedor       String?          @db.VarChar(50)
  ref_proveedor   String?          @db.VarChar(100)
  ref_variante    String?          @db.VarChar(100)
  sku_interno     String?          @unique @db.VarChar(100)
  ean             String?          @db.VarChar(50)
  marca           String?          @db.VarChar(100)
  categoria_texto String?          @db.VarChar(200)
  categoria_padre String?          @db.VarChar(200)
  color           String?          @db.VarChar(50)
  talla           String?          @db.VarChar(50)
  activo          Boolean          @default(true)
  visible_web     Boolean          @default(true)
  id              Int              @id @default(autoincrement())
  grupo           String?          @db.VarChar(100)
  tipo_producto   String?          @db.VarChar(100)
  orderItems      OrderItem[]
  variants        ProductVariant[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku_interno])
  @@index([proveedor])
  @@index([visible_web, activo])
  @@index([subcategory])
  @@index([grupo], map: "idx_product_grupo")
  @@index([tipo_producto])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  proveedor     String?  @db.VarChar(50)
  ref_proveedor String?  @db.VarChar(100)
  ref_variante  String?  @db.VarChar(100)
  sku_interno   String   @unique @db.VarChar(120)
  ean           String?  @db.VarChar(50)
  color         String?  @db.VarChar(50)
  talla         String?  @db.VarChar(50)
  stock         Int      @default(0)
  price         Decimal? @db.Decimal(10, 2)
  images        String[]
  activo        Boolean  @default(true)
  visible_web   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([proveedor, ref_proveedor, ref_variante], map: "ProductVariant_ref_idx")
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  nombreCompleto    String?
  nombreCentro      String?
  email             String
  telefono          String
  direccion         String?
  status            OrderStatus @default(PENDING)
  total             Decimal     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  couponCode        String?
  discountAmount    Decimal?    @db.Decimal(10, 2)
  paymentMethod     String?
  apellidos         String?
  ciudad            String?
  codigoPostal      String?
  direccionCompleta String?
  nifCif            String?
  nombre            String?
  piso              String?
  provincia         String?
  items             OrderItem[]
  redsysOrderId     String?   @unique @db.VarChar(12)

  @@index([orderNumber])
  @@index([email])
  @@index([status])
  @@index([couponCode])
  @@index([paymentMethod])
  @@index([codigoPostal])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productName String
  productSlug String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  productId   Int
  variantId   Int?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal   @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
