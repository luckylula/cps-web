generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                Int       @id @default(autoincrement())
  name              String
  slug              String    @unique
  description       String?   @db.Text
  price             Decimal?  @db.Decimal(10, 2)
  images            String[]
  stock             Int       @default(0)
  published         Boolean   @default(false)
  featured          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Sistema de categorías del cliente
  categoryId        String    // 'deportes', 'textil', 'instalaciones', 'material-escolar'
  subcategory       String?
  
  // Campos multi-proveedor
  proveedor         String?   @db.VarChar(50)  // 'jim_sports', 'made_for_sport'
  ref_proveedor     String?   @db.VarChar(100)
  ref_variante      String?   @db.VarChar(100)
  sku_interno       String?   @unique @db.VarChar(100)
  ean               String?   @db.VarChar(50)
  marca             String?   @db.VarChar(100)
  categoria_texto   String?   @db.VarChar(200)
  categoria_padre   String?   @db.VarChar(200)
  color             String?   @db.VarChar(50)
  talla             String?   @db.VarChar(50)
  activo            Boolean   @default(true)
  visible_web       Boolean   @default(true)
  
  orderItems        OrderItem[]
  variants          ProductVariant[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku_interno])
  @@index([proveedor])
  @@index([visible_web, activo])
  @@index([subcategory])
}

model ProductVariant {
  id            Int       @id @default(autoincrement())
  productId     Int
  sku_interno   String?   @unique @db.VarChar(100)
  color         String?   @db.VarChar(50)
  talla         String?   @db.VarChar(50)
  stock         Int       @default(0)
  images        String[]
  activo        Boolean   @default(true)
  visible_web   Boolean   @default(true)
  proveedor     String?   @db.VarChar(50)
  ref_proveedor String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@index([sku_interno])
  @@index([visible_web, activo])
  @@index([color])
  @@index([talla])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique

  // Campos nuevos (separados) - Opcionales para compatibilidad con pedidos legacy
  nombre         String?
  apellidos      String?
  nifCif         String?
  direccion      String?     // Calle y número
  piso           String?
  codigoPostal   String?
  ciudad         String?
  provincia      String?

  // Campos legacy (mantener para compatibilidad)
  nombreCompleto String?
  direccionCompleta String?  @db.Text

  // Información de contacto
  nombreCentro   String?
  email          String
  telefono       String

  // Información del pedido
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  couponCode     String?
  discountAmount Decimal?    @db.Decimal(10, 2)
  paymentMethod  String?
  items          OrderItem[]

  @@index([orderNumber])
  @@index([email])
  @@index([status])
  @@index([couponCode])
  @@index([paymentMethod])
  @@index([codigoPostal])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   Int
  variantId   Int?     // Nullable para productos sin variantes
  productName String
  productSlug String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal   @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
