generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Decimal     @db.Decimal(10, 2)
  images      String[]
  stock       Int         @default(0)
  categoryId  String
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  subcategory String?
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([slug])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique

  // Campos nuevos (separados) - Opcionales para compatibilidad con pedidos legacy
  nombre         String?
  apellidos      String?
  nifCif         String?
  direccion      String?     // Calle y número
  piso           String?
  codigoPostal   String?
  ciudad         String?
  provincia      String?

  // Campos legacy (mantener para compatibilidad)
  nombreCompleto String?
  direccionCompleta String?  @db.Text

  // Información de contacto
  nombreCentro   String?
  email          String
  telefono       String

  // Información del pedido
  status         OrderStatus @default(PENDING)
  total          Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  couponCode     String?
  discountAmount Decimal?    @db.Decimal(10, 2)
  paymentMethod  String?
  items          OrderItem[]

  @@index([orderNumber])
  @@index([email])
  @@index([status])
  @@index([couponCode])
  @@index([paymentMethod])
  @@index([codigoPostal])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSlug String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal   @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
